# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/tinat?schema=public"

# App Configuration
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication
AUTH_SECRET="your-jwt-auth-secret-min-32-chars"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI Intelligence (Google Gemini)
GEMINI_API_KEY=""

# Email Service (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="noreply@tinat.org"
SUPPORT_EMAIL="support@tinat.org"

# Payment Gateway (Chapa)
CHAPA_SECRET_KEY=""
CHAPA_PUBLIC_KEY=""
CHAPA_WEBHOOK_SECRET=""
