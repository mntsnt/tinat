generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                           String                   @id @default(cuid())
  name                         String
  username                     String?                  @unique
  email                        String                   @unique
  passwordHash                 String
  role                         UserRole                 @default(PARTICIPANT)
  phone                        String?
  institution                  String?
  fieldOfStudy                 String?
  yearOfStudy                  Int?
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt
  avatarUrl                    String?
  bio                          String?
  isVerified                   Boolean                  @default(false)
  faydaVerified                Boolean                  @default(false)
  faydaFanHash                 String?                  @unique
  faydaVerifiedAt              DateTime?
  verificationCode             String?
  verificationCodeExpiresAt    DateTime?
  aiConversations              AIConversation[]
  aiUsages                     AIUsage[]
  activityLogs                 ActivityLog[]
  adminChatMessages             AdminChatMessage[]
  askProfile                   AskProfile?
  collectionSessions           CollectionSession[]      @relation("CollectorSessions")
  receivedCollectorInvitations CollectorInvitation[]    @relation("CollectorInvitee")
  sentCollectorInvitations     CollectorInvitation[]    @relation("CollectorInviter")
  notifications                Notification[]
  projectActivities            ProjectActivity[]
  projectChatMessages          ProjectChatMessage[]
  projectDecisions             ProjectDecision[]        @relation("DecisionMadeBy")
  projectDiscussions           ProjectDiscussion[]
  projectDiscussionReplies     ProjectDiscussionReply[]
  projectDiscussionReactions   ProjectDiscussionReaction[]
  projectDiscussionReplyReactions ProjectDiscussionReplyReaction[]
  uploadedProjectFiles         ProjectFile[]
  uploadedProjectFileVersions  ProjectFileVersion[]
  sentProjectInvitations       ProjectInvitation[]      @relation("ProjectInviter")
  linkedProjectStudies         ProjectLinkedStudy[]
  projectMemberships           ProjectMember[]
  projectNotes                 ProjectNote[]
  assignedProjectTasks         ProjectTask[]            @relation("TaskAssignee")
  createdProjectTasks          ProjectTask[]            @relation("TaskCreator")
  leadProjects                 ResearchProject[]        @relation("ProjectLead")
  collectedResponses           Response[]               @relation("CollectedResponses")
  participantLinks             ParticipantLink[]
  dataSubjectRequests          DataSubjectRequest[]
  termsAcceptedVersion         String?
  termsAcceptedAt              DateTime?
  charterAcceptedVersion       String?
  charterAcceptedAt            DateTime?
  codeOfConductAcceptedVersion String?
  codeOfConductAcceptedAt      DateTime?
  dpaAcceptedVersion           String?
  dpaAcceptedAt                DateTime?
  moderationReports            ModerationReport[]
  verifiedEthicsApprovals      EthicsApproval[]         @relation("EthicsVerifier")
  privacyNoticeVersion         String                   @default("1.0")
  privacyAcceptedAt            DateTime?
  studies                      Study[]
  bookmarks                    StudyBookmark[]
  comments                     StudyComment[]
  assignedStudies              StudyDataCollector[]     @relation("AssignedCollector")
  collectorApplications        CollectorApplication[]   @relation("CollectorApplications")
  likes                        StudyLike[]
  studyPayments                StudyPayment[]
  ratings                      StudyRating[]
  reviewedVerifications        Verification[]           @relation("AdminReviews")
  verifications                Verification[]           @relation("UserVerifications")
  wallet                       Wallet?
  ledgerAccount                LedgerAccount?
  withdrawals                  Withdrawal[]
  platformConsentRecords       PlatformConsentRecord[]
}

model Study {
  id                   String                @id @default(cuid())
  title                String
  description          String?
  bannerTheme          String                @default("canopy")
  status               StudyStatus           @default(DRAFT)
  fundingType          StudyFundingType      @default(FREE)
  creditPerResponse    Int                   @default(0)
  creditBudget         Int                   @default(0)
  creditsSpent         Int                   @default(0)
  requiresReapproval   Boolean               @default(false)
  rewardCredits        Int                   @default(0)
  researcherId         String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  budgetCredits        Int                   @default(0)
  creditsPaid          Int                   @default(0)
  participantTarget    Int                   @default(0)
  eligibilityCriteria  String?
  tags                 String[]
  category             String?
  estimatedMinutes     Int?                  @default(5)
  objective            String?
  studyType            StudyType             @default(FUNDED)
  targetPopulation     String?
  ethicsApproval           EthicsApproval?
  ethicsExempt             Boolean               @default(false)
  ethicsExemptionReason     String?
  ethicsExemptedByAdminId  String?
  ethicsExemptedAt         DateTime?
  populationDescription    String?
  recruitmentMethod        String?
  containsSensitiveTopics  Boolean               @default(false)
  involvesMinors           Boolean               @default(false)
  safetyProtocolText       String?
  firstApprovedByAdminId   String?
  secondApprovedByAdminId  String?
  consentForms             ConsentForm[]
  moderationReports        ModerationReport[]
  aiConversations      AIConversation[]
  collectionSessions   CollectionSession[]   @relation("StudyCollectionSessions")
  collectorInvitations CollectorInvitation[] @relation("StudyCollectorInvitations")
  linkedProjects       ProjectLinkedStudy[]
  questions            Question[]
  responses            Response[]
  participantLinks     ParticipantLink[]
  researcher           User                  @relation(fields: [researcherId], references: [id], onDelete: Cascade)
  bookmarks            StudyBookmark[]
  comments             StudyComment[]
  dataCollectors       StudyDataCollector[]  @relation("StudyDataCollectors")
  collectorApplications CollectorApplication[] @relation("StudyCollectorApplications")
  likes                StudyLike[]
  payments             StudyPayment[]
  ratings              StudyRating[]
  translations         StudyTranslation[]
}

model StudyBookmark {
  id        String   @id @default(cuid())
  userId    String
  studyId   String
  createdAt DateTime @default(now())
  study     Study    @relation(fields: [studyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, studyId])
}

model StudyRating {
  id        String   @id @default(cuid())
  userId    String
  studyId   String
  rating    Int
  feedback  String?
  createdAt DateTime @default(now())
  study     Study    @relation(fields: [studyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, studyId])
}

model StudyLike {
  id        String   @id @default(cuid())
  userId    String
  studyId   String
  createdAt DateTime @default(now())
  study     Study    @relation(fields: [studyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, studyId])
}

model StudyComment {
  id        String         @id @default(cuid())
  userId    String
  studyId   String
  text      String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  parentId  String?
  parent    StudyComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   StudyComment[] @relation("CommentReplies")
  study     Study          @relation(fields: [studyId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([studyId])
  @@index([parentId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id           String   @id @default(cuid())
  userId       String
  action       String
  description  String?
  resourceId   String?
  resourceType String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, action])
  @@index([resourceId, resourceType])
  @@index([createdAt])
}

model IncidentLog {
  id              String   @id @default(cuid())
  type            String   @default("SECURITY_INCIDENT")
  severity        String   @default("HIGH")
  category        String   @default("DATA_PROTECTION")
  description     String
  detectedAt      DateTime @default(now())
  dataAffected    String?
  notifiedParties String?
  status          String   @default("OPEN")
  metadata        Json?
  resolved        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([severity])
  @@index([createdAt])
  @@index([status])
}

model AdminChatMessage {
  id        String   @id @default(cuid())
  channel   String
  senderId  String
  content   String   @db.VarChar(1500)
  createdAt DateTime @default(now())
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([channel, createdAt])
  @@index([senderId, createdAt])
}

model Question {
  id            String           @id @default(cuid())
  studyId       String
  text          String
  type          QuestionType
  required      Boolean          @default(true)
  isSkippable   Boolean          @default(false)
  preferNotToAnswerEnabled Boolean @default(true)
  order         Int
  createdAt     DateTime         @default(now())
  scaleMax      Int?
  scaleMaxLabel String?
  scaleMin      Int?
  scaleMinLabel String?
  answers       Answer[]
  study         Study            @relation(fields: [studyId], references: [id], onDelete: Cascade)
  options       QuestionOption[]
  rows          QuestionRow[]
  translations  QuestionTranslation[]
}

model QuestionRow {
  id         String   @id @default(cuid())
  questionId String
  text       String
  value      String
  order      Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  text       String
  value      String
  order      Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

enum DataSubjectRequestType {
  ACCESS
  RECTIFICATION
  ERASURE
  WITHDRAW_CONSENT
}

enum DataSubjectRequestStatus {
  PENDING
  IN_REVIEW
  COMPLETED
  REJECTED
}

model ParticipantLink {
  id             String   @id @default(cuid())
  userId         String
  studyId        String
  respondentCode String   @unique
  createdAt      DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  study Study @relation(fields: [studyId], references: [id], onDelete: Cascade)

  @@unique([studyId, userId])
  @@index([studyId])
  @@index([userId])
}

model DataSubjectRequest {
  id          String                   @id @default(cuid())
  userId      String
  type        DataSubjectRequestType
  status      DataSubjectRequestStatus @default(PENDING)
  reason      String?
  details     Json?
  dueDate     DateTime
  completedAt DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Response {
  id                  String             @id @default(cuid())
  studyId             String
  respondentCode      String             @unique
  submittedAt         DateTime           @default(now())
  collectionMethod    CollectionMethod   @default(SELF)
  collectorId         String?
  collectionSessionId String?
  ipHash              String?
  deviceFingerprint   String?
  language            String             @default("en")
  answers             Answer[]
  session             CollectionSession? @relation("SessionResponses", fields: [collectionSessionId], references: [id])
  collector           User?              @relation("CollectedResponses", fields: [collectorId], references: [id])
  study               Study              @relation(fields: [studyId], references: [id], onDelete: Cascade)

  @@unique([studyId, respondentCode])
  @@index([studyId])
}

model Answer {
  id          String   @id @default(cuid())
  responseId  String
  questionId  String
  textValue   String?
  numberValue Float?
  createdAt   DateTime @default(now())
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  response    Response @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@unique([responseId, questionId])
}

model Wallet {
  id             String                   @id @default(cuid())
  userId         String                   @unique
  balance        Int                      @default(0)
  pendingBalance Int                      @default(0)
  totalEarned    Int                      @default(0)
  totalWithdrawn Int                      @default(0)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  transactions   TinatCreditTransaction[]
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TinatCreditTransaction {
  id             String          @id @default(cuid())
  walletId       String
  amount         Int
  type           TransactionType
  reason         String?
  idempotencyKey String?         @unique
  balanceAfter   Int?
  createdAt      DateTime        @default(now())
  wallet         Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([type])
  @@index([idempotencyKey])
}

enum LedgerAccountKind {
  SYSTEM_ISSUANCE
  USER_WALLET
}

model LedgerAccount {
  id        String            @id @default(cuid())
  kind      LedgerAccountKind
  userId    String?           @unique
  balance   Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  user      User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries   LedgerEntry[]

  @@index([kind])
}

model LedgerJournal {
  id             String        @id @default(cuid())
  idempotencyKey String        @unique
  description    String
  studyId        String?
  responseId     String?       @unique
  createdAt      DateTime      @default(now())
  entries        LedgerEntry[]

  @@index([studyId])
}

model LedgerEntry {
  id           String        @id @default(cuid())
  journalId    String
  accountId    String
  amount       Int
  balanceAfter Int
  createdAt    DateTime      @default(now())
  account      LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  journal      LedgerJournal @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([journalId])
}

model StudyPayment {
  id           String        @id @default(cuid())
  studyId      String
  researcherId String
  amount       Float
  currency     String        @default("ETB")
  txRef        String        @unique
  chapaRef     String?
  status       PaymentStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  researcher   User          @relation(fields: [researcherId], references: [id], onDelete: Cascade)
  study        Study         @relation(fields: [studyId], references: [id], onDelete: Cascade)

  @@index([studyId])
  @@index([researcherId])
}

model Withdrawal {
  id          String           @id @default(cuid())
  userId      String
  amount      Int
  method      String
  accountInfo String
  status      WithdrawalStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model AskProfile {
  id                 String        @id @default(cuid())
  userId             String        @unique
  username           String        @unique
  displayName        String?
  bio                String?
  avatarUrl          String?
  theme              String        @default("emerald")
  isEnabled          Boolean       @default(true)
  allowPublicAnswers Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions          AskQuestion[]

  @@index([username])
}

model AskQuestion {
  id           String            @id @default(cuid())
  profileId    String
  questionText String
  status       AskQuestionStatus @default(UNANSWERED)
  answerText   String?
  answeredAt   DateTime?
  isPublic     Boolean           @default(false)
  deckConfig   Json?
  reportCount  Int               @default(0)
  isBlocked    Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  profile      AskProfile        @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, status])
  @@index([profileId, createdAt])
  @@index([profileId, isPublic])
}

model ResearchProject {
  id               String               @id @default(cuid())
  title            String
  slug             String?              @unique
  description      String?
  researchQuestion String?
  objective        String?
  category         String
  studyDesign      String
  researchArea     String?
  institution      String?
  projectLeadId    String
  startDate        DateTime?
  endDate          DateTime?
  status           ProjectStatus        @default(ACTIVE)
  currentPhase     ProjectPhase         @default(PLANNING)
  visibility       ProjectVisibility    @default(TEAM)
  customPhases     String[]             @default([])
  isArchived       Boolean              @default(false)
  inviteToken      String?              @unique
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  aiConversations  AIConversation[]
  activities       ProjectActivity[]
  chatMessages     ProjectChatMessage[]
  decisions        ProjectDecision[]
  discussions      ProjectDiscussion[]
  files            ProjectFile[]
  invitations      ProjectInvitation[]
  linkedStudies    ProjectLinkedStudy[]
  members          ProjectMember[]
  milestones       ProjectMilestone[]
  notes            ProjectNote[]
  outputs          ProjectOutput[]
  tasks            ProjectTask[]
  lead             User                 @relation("ProjectLead", fields: [projectLeadId], references: [id], onDelete: Cascade)

  @@index([projectLeadId])
  @@index([status])
  @@index([category])
  @@index([visibility])
}

model ProjectMember {
  id                String          @id @default(cuid())
  projectId         String
  userId            String
  role              ProjectRole     @default(RESEARCHER)
  title             String?
  joinedAt          DateTime        @default(now())
  customPermissions Json?
  project           ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model ProjectInvitation {
  id           String           @id @default(cuid())
  projectId    String
  inviterId    String
  inviteeEmail String
  role         ProjectRole      @default(RESEARCHER)
  message      String?
  token        String           @unique
  status       InvitationStatus @default(PENDING)
  expiresAt    DateTime
  createdAt    DateTime         @default(now())
  inviter      User             @relation("ProjectInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  project      ResearchProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([inviteeEmail])
  @@index([token])
}

model ProjectMilestone {
  id          String          @id @default(cuid())
  projectId   String
  title       String
  description String?
  deadline    DateTime?
  phase       ProjectPhase    @default(PLANNING)
  isCompleted Boolean         @default(false)
  completedAt DateTime?
  order       Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  project     ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       ProjectTask[]

  @@index([projectId, phase])
}

model ProjectTask {
  id          String              @id @default(cuid())
  projectId   String
  milestoneId String?
  creatorId   String
  assigneeId  String?
  title       String
  description String?
  status      ProjectTaskStatus   @default(TODO)
  priority    ProjectTaskPriority @default(MEDIUM)
  phase       ProjectPhase        @default(PLANNING)
  dueDate     DateTime?
  labels      String[]            @default([])
  subtasks    Json?
  completedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  assignee    User?               @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator     User                @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  milestone   ProjectMilestone?   @relation(fields: [milestoneId], references: [id])
  project     ResearchProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([assigneeId])
  @@index([milestoneId])
}

model ProjectFile {
  id                    String               @id @default(cuid())
  projectId             String
  uploaderId            String
  folder                ProjectFileFolder    @default(PROTOCOL)
  name                  String
  fileUrl               String
  fileType              String
  fileSize              Int                  @default(0)
  version               Int                  @default(1)
  isSensitiveHealthData Boolean              @default(false)
  notes                 String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  project               ResearchProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader              User                 @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  versions              ProjectFileVersion[]

  @@index([projectId, folder])
}

model ProjectFileVersion {
  id            String      @id @default(cuid())
  fileId        String
  uploaderId    String
  version       Int
  fileUrl       String
  fileSize      Int         @default(0)
  changeSummary String?
  createdAt     DateTime    @default(now())
  file          ProjectFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  uploader      User        @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([fileId])
}

model ProjectNote {
  id        String          @id @default(cuid())
  projectId String
  authorId  String
  category  String
  title     String
  content   String
  isPinned  Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  author    User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  project   ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, category])
}

model ProjectDiscussion {
  id         String                   @id @default(cuid())
  projectId  String
  authorId   String
  title      String
  content    String
  category   String                   @default("General")
  isResolved Boolean                  @default(false)
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt
  author     User                     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  project    ResearchProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  replies    ProjectDiscussionReply[]
  reactions ProjectDiscussionReaction[]

  @@index([projectId])
}

model ProjectDiscussionReply {
  id           String            @id @default(cuid())
  discussionId String
  authorId     String
  content      String
  createdAt    DateTime          @default(now())
  author       User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  discussion   ProjectDiscussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  reactions    ProjectDiscussionReplyReaction[]

  @@index([discussionId])
}

model ProjectDiscussionReaction {
  id           String            @id @default(cuid())
  discussionId String
  userId       String
  createdAt    DateTime          @default(now())
  discussion   ProjectDiscussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([discussionId, userId])
  @@index([discussionId])
}

model ProjectDiscussionReplyReaction {
  id        String                 @id @default(cuid())
  replyId   String
  userId    String
  createdAt DateTime               @default(now())
  reply     ProjectDiscussionReply @relation(fields: [replyId], references: [id], onDelete: Cascade)
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([replyId, userId])
  @@index([replyId])
}

model ProjectDecision {
  id             String          @id @default(cuid())
  projectId      String
  decisionNumber Int
  decision       String
  reason         String?
  status         DecisionStatus  @default(ACTIVE)
  madeById       String
  supersededById String?
  relatedDoc     String?
  date           DateTime        @default(now())
  createdAt      DateTime        @default(now())
  madeBy         User            @relation("DecisionMadeBy", fields: [madeById], references: [id], onDelete: Cascade)
  project        ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, decisionNumber])
}

model ProjectActivity {
  id          String          @id @default(cuid())
  projectId   String
  userId      String
  action      String
  description String
  metadata    Json?
  createdAt   DateTime        @default(now())
  project     ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model ProjectChatMessage {
  id        String          @id @default(cuid())
  projectId String
  senderId  String
  content   String
  taskId    String?
  fileUrl   String?
  createdAt DateTime        @default(now())
  project   ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sender    User            @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model ProjectLinkedStudy {
  id         String          @id @default(cuid())
  projectId  String
  studyId    String
  linkedById String
  notes      String?
  createdAt  DateTime        @default(now())
  linkedBy   User            @relation(fields: [linkedById], references: [id], onDelete: Cascade)
  project    ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  study      Study           @relation(fields: [studyId], references: [id], onDelete: Cascade)

  @@unique([projectId, studyId])
  @@index([projectId])
  @@index([studyId])
}

model ProjectOutput {
  id                 String              @id @default(cuid())
  projectId          String
  title              String
  type               ProjectOutputType   @default(RESEARCH_PAPER)
  status             ProjectOutputStatus @default(DRAFT)
  targetJournal      String?
  linkUrl            String?
  fileUrl            String?
  submissionDeadline DateTime?
  publicationDate    DateTime?
  contributors       String[]            @default([])
  manuscriptSections Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  project            ResearchProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, type])
}

model AIConversation {
  id        String           @id @default(cuid())
  userId    String
  title     String?
  projectId String?
  studyId   String?
  provider  AIProvider       @default(GEMINI)
  model     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  artifacts AIArtifact[]
  project   ResearchProject? @relation(fields: [projectId], references: [id])
  study     Study?           @relation(fields: [studyId], references: [id])
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AIMessage[]
  usage     AIUsage[]

  @@index([userId])
  @@index([projectId])
  @@index([studyId])
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           AIMessageRole
  content        String
  toolCalls      Json?
  toolResults    Json?
  createdAt      DateTime       @default(now())
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model AIArtifact {
  id             String         @id @default(cuid())
  conversationId String
  type           AIArtifactType
  title          String
  content        String
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model AIUsage {
  id               String         @id @default(cuid())
  conversationId   String
  userId           String
  provider         AIProvider
  model            String
  promptTokens     Int            @default(0)
  completionTokens Int            @default(0)
  totalTokens      Int            @default(0)
  cost             Float          @default(0)
  createdAt        DateTime       @default(now())
  conversation     AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([conversationId])
}

model Verification {
  id                    String             @id @default(cuid())
  userId                String
  verificationType      VerificationType
  status                VerificationStatus @default(PENDING)
  submittedAt           DateTime           @default(now())
  reviewedAt            DateTime?
  reviewedById          String?
  rejectionReason       String?
  verificationReference String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  reviewedBy            User?              @relation("AdminReviews", fields: [reviewedById], references: [id])
  user                  User               @relation("UserVerifications", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, verificationType])
  @@index([status])
}

model StudyDataCollector {
  id         String   @id @default(cuid())
  studyId    String
  userId     String
  assignedAt DateTime @default(now())
  study      Study    @relation("StudyDataCollectors", fields: [studyId], references: [id], onDelete: Cascade)
  user       User     @relation("AssignedCollector", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([studyId, userId])
}

model CollectorInvitation {
  id        String           @id @default(cuid())
  studyId   String
  inviterId String
  inviteeId String
  status    InvitationStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  invitee   User             @relation("CollectorInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  inviter   User             @relation("CollectorInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  study     Study            @relation("StudyCollectorInvitations", fields: [studyId], references: [id], onDelete: Cascade)

  @@unique([studyId, inviteeId])
}

model CollectorApplication {
  id          String            @id @default(cuid())
  studyId     String
  applicantId String
  status      ApplicationStatus @default(PENDING)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  applicant   User              @relation("CollectorApplications", fields: [applicantId], references: [id], onDelete: Cascade)
  study       Study             @relation("StudyCollectorApplications", fields: [studyId], references: [id], onDelete: Cascade)

  @@unique([studyId, applicantId])
  @@index([studyId, status])
  @@index([applicantId])
}

enum ApplicationStatus {
  PENDING
  APPROVED
  DECLINED
}

model CollectionSession {
  id          String        @id @default(cuid())
  studyId     String
  collectorId String
  startTime   DateTime      @default(now())
  endTime     DateTime?
  status      SessionStatus @default(ACTIVE)
  collector   User          @relation("CollectorSessions", fields: [collectorId], references: [id], onDelete: Cascade)
  study       Study         @relation("StudyCollectionSessions", fields: [studyId], references: [id], onDelete: Cascade)
  responses   Response[]    @relation("SessionResponses")

  @@index([studyId])
  @@index([collectorId])
}

