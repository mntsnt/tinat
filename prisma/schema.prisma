model EthicsApproval {
  id                 String               @id @default(cuid())
  studyId            String               @unique
  study              Study                @relation(fields: [studyId], references: [id], onDelete: Cascade)
  committeeName      String
  approvalNumber     String
  approvalDate       DateTime
  expiryDate         DateTime
  documentPath       String
  verifiedByAdminId  String?
  verifiedByAdmin    User?                @relation("EthicsVerifier", fields: [verifiedByAdminId], references: [id], onDelete: SetNull)
  verifiedAt         DateTime?
  status             EthicsApprovalStatus @default(PENDING)
  adminNotes         String?
  checklist          Json?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([status])
  @@index([expiryDate])
}

model ConsentForm {
  id                     String          @id @default(cuid())
  studyId                String
  study                  Study           @relation(fields: [studyId], references: [id], onDelete: Cascade)
  version                Int             @default(1)
  language               String          @default("en")
  keyInformation         Json
  fullText               String
  comprehensionQuestions Json?
  createdAt              DateTime        @default(now())
  records                ConsentRecord[]

  @@unique([studyId, version, language])
  @@index([studyId])
}

model ConsentRecord {
  id                   String      @id @default(cuid())
  respondentCode       String
  consentFormId        String
  consentForm          ConsentForm @relation(fields: [consentFormId], references: [id], onDelete: Restrict)
  acceptedAt           DateTime    @default(now())
  comprehensionAnswers Json
  language             String      @default("en")
  withdrawnAt          DateTime?
  withdrawalReason     String?

  @@index([respondentCode])
  @@index([consentFormId])
}

model ModerationReport {
  id                String           @id @default(cuid())
  reporterId        String?
  reporter          User?            @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  studyId           String?
  study             Study?           @relation(fields: [studyId], references: [id], onDelete: SetNull)
  resourceType      String
  resourceId        String
  reason            String
  details           String
  status            ModerationStatus @default(OPEN)
  resolutionNotes   String?
  resolvedByAdminId String?
  resolvedAt        DateTime?
  deadline          DateTime
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([status])
  @@index([deadline])
  @@index([resourceId, resourceType])
}

model EthicsBoardMember {
  id          String   @id @default(cuid())
  name        String
  title       String
  institution String
  role        String
  appointedAt DateTime @default(now())
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EthicsBoardDecision {
  id          String   @id @default(cuid())
  title       String
  meetingDate DateTime
  summary     String
  resolution  String
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model StudyTranslation {
  id                 String   @id @default(cuid())
  studyId            String
  study              Study    @relation(fields: [studyId], references: [id], onDelete: Cascade)
  language           String
  title              String
  description        String?
  objective          String?
  safetyProtocolText String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([studyId, language])
  @@index([studyId])
}

model QuestionTranslation {
  id           String   @id @default(cuid())
  questionId   String
  question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  language     String
  text         String
  options      Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([questionId, language])
  @@index([questionId])
}

model PlatformConsentRecord {
  id                     String   @id @default(cuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  termsVersion           String
  privacyVersion         String
  summaryVersion         String
  documentHash           String
  optionalContactConsent Boolean  @default(false)
  acceptedAt             DateTime @default(now())
  ipHash                 String?
  locale                 String   @default("en")
  createdAt              DateTime @default(now())

  @@index([userId])
  @@index([documentHash])
}
